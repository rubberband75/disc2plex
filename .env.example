# TMDB v3 API read-access bearer token (https://www.themoviedb.org/settings/api)
TMDB_API_TOKEN=

# Only needed when using --llm claude
ANTHROPIC_API_KEY=

# Optional: avoids anonymous rate limits when downloading Whisper models
# HF_TOKEN=

# Optional: local OpenAI-compatible LLM for --llm local (Ollama default shown)
# DISC2PLEX_LLM_MODEL=llama3.1:8b
# DISC2PLEX_LLM_BASE_URL=http://localhost:11434/v1
# DISC2PLEX_LLM_API_KEY=

# Optional: Plex scan after apply (see [plex] in config.toml)
# PLEX_TOKEN=
